SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PROJECT_ID=hocker-one
NODE_ID=hocker-node-1

# Must be distinct secrets, each at least 24 characters.
HOCKER_COMMAND_HMAC_SECRET=
HOCKER_AGENT_KEY=
# Legacy compatibility:
# COMMAND_HMAC_SECRET=

MAX_COMMAND_AGE_MS=300000
POLL_MS=5000
HEARTBEAT_MS=15000

SANDBOX_ENABLED=true
SANDBOX_ROOT=/opt/hocker-node-agent/sandbox

# The agent listens on loopback by default.
HOCKER_AGENT_HOST=127.0.0.1
PORT=8081
ORCHESTRATOR_URL=

# Docker/LAN exposure requires an explicit opt-in and a network firewall.
# HOCKER_AGENT_HOST=0.0.0.0
# HOCKER_AGENT_ALLOW_LAN=true
HOCKER_AGENT_ALLOW_LAN=false

# Raw shell is not an OS sandbox and remains disabled in production by default.
HOCKER_ALLOW_UNSANDBOXED_SHELL=false
# Optional fixed executable search path when break-glass shell is enabled.
# HOCKER_SHELL_PATH=/usr/local/bin:/usr/bin:/bin

# Operational contract:
# - github.* is cloud-only and executes through Hocker ONE Owner Gate.
# - fs.write is restricted to SANDBOX_ROOT and requires allow_write=true.
# - shell.exec requires allow_write=true plus HOCKER_ALLOW_UNSANDBOXED_SHELL=true.

# Mirror node
MIRROR_ENABLED=false
MIRROR_PRIMARY_NODE_ID=
MIRROR_NODE_ID=
