SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PROJECT_ID=hocker-one
NODE_ID=hocker-node-1

HOCKER_COMMAND_HMAC_SECRET=
# compat legacy:
# COMMAND_HMAC_SECRET=

MAX_COMMAND_AGE_MS=300000
POLL_MS=5000

SANDBOX_ENABLED=true
SANDBOX_ROOT=/opt/hocker-node-agent/sandbox

# El agente escucha solo en loopback por defecto.
HOCKER_AGENT_HOST=127.0.0.1
PORT=8081
HOCKER_AGENT_KEY=
ORCHESTRATOR_URL=

# Para Docker/LAN debe habilitarse de forma explícita:
# HOCKER_AGENT_HOST=0.0.0.0
# HOCKER_AGENT_ALLOW_LAN=true
HOCKER_AGENT_ALLOW_LAN=false

# shell.exec no sandboxed permanece desactivado salvo habilitación explícita.
HOCKER_ALLOW_UNSANDBOXED_SHELL=false

# Contrato operativo:
# CLOUD_ONLY_COMMANDS=github.*
# github.* se ejecuta en hocker.one / cloud-hocker-one, no en este agente.

# === HEARTBEAT (Real-time node presence) ===
HEARTBEAT_MS=15000

# === MIRROR NODE (Nodo Espejo) ===
MIRROR_ENABLED=false
MIRROR_PRIMARY_NODE_ID=
MIRROR_NODE_ID=
