{
  "name": "hocker-node-agent",
  "version": "2.3.0",
  "description": "Agente ejecutor seguro para HOCKER",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "dotenv": "^16.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "8.21.1"
  },
  "engines": {
    "node": "22.x"
  }
}
